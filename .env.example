# Django Backend Configuration
# Generate a unique key locally; never commit the resulting .env.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database (optional PostgreSQL, defaults to SQLite if empty)
# POSTGRES_DB=kanban_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
PORT=3001
